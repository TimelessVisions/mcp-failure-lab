# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Node (TypeScript targets / viewer)
node_modules/
targets/typescript/**/dist/
viewer/dist/
viewer/playwright-report/
viewer/test-results/
# The bundled dataset is generated by `mcp-failure-lab viewer export`, never
# committed. Committing one would put a snapshot of an execution in the source
# tree where nothing verifies it against a manifest, and the private one would
# be one wrong path away from a public build.
viewer/public/data/
viewer/data/

# Harness output — artifacts are produced, not committed.
# Curated example artifacts are force-added explicitly.
# A negation cannot re-include a path whose parent directory is excluded, so the
# examples directory itself must be un-ignored before its contents.
artifacts/*
!artifacts/.gitkeep
!artifacts/examples/
!artifacts/examples/**
# Private third-party findings. Stored here because artifacts on disk are the
# source of truth; PRIVATE because they concern code this project does not own.
# Storing them in a private repository is not publication — see
# docs/responsible-disclosure.md before anything leaves it.
!artifacts/private-findings/
!artifacts/private-findings/**
# Replay output written *inside* a package when run.sh executes there.
# The package is evidence; a replay's own output is not part of it.
artifacts/private-findings/*/artifacts/

# Private benchmark results must never be published
benchmarks/private-results/**
!benchmarks/private-results/.gitkeep

# The private demo's recording is real third-party evidence on video. The
# script, storyboard, timeline and runbook beside it are committed — they
# describe the recording without containing any of it. The recording itself is
# produced locally, shown to an authorized reviewer, and deleted.
demos/private/recording/
demos/private/captions.vtt

# Local scratch
.interop-lab/
*.local.yaml
.env
.DS_Store

# Proxy CA copied in only to build an external target image on a machine
# behind a TLS-terminating proxy. Environment-specific; never committed.
targets/external/*/ca-bundle.crt
